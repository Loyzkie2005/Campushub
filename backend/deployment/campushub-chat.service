[Unit]
Description=CampusHub FastAPI chat
After=network.target postgresql@18-main.service

[Service]
Type=simple
User=campushub
Group=campushub
WorkingDirectory=/srv/campushub/current/backend/chat_service
EnvironmentFile=/etc/campushub/chat.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/campushub/venvs/chat/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/campushub/shared

[Install]
WantedBy=multi-user.target
